# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger_test

# --- Transaction retry (serialization / lock contention) ---
TX_MAX_RETRIES=5

# --- Stretch: snapshots ---
SNAPSHOT_INTERVAL_EVENTS=1000
SNAPSHOT_MAX_LAG_EVENTS=5000

# --- Stretch: FX ---
FX_PROVIDER=off
FX_BASE_URL=
FX_API_KEY=

# --- Nice-to-have: auth / rate limiting ---
API_KEYS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
